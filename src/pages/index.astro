---
import Base from '../layouts/Base.astro';
import { getPosts, shortDate } from '../lib/posts';

const posts = await getPosts();
const years = [...new Set(posts.map((p) => p.data.date.getUTCFullYear()))];
---

<Base title="The Founder Edit — Wen's notes on entrepreneurship and wellbeing" current="writing">
  <section class="intro"><h1>Hi, I'm <em class="name">Wen</em>.</h1><p>Founder of SushiVid, accidental entrepreneur, and lifelong student of my own head. I write about building a business, staying well while doing it, and everything I figure out along the way. <a href="/about">More about me →</a></p></section>
  {years.map((year) => (
    <section class="year-group">
      <h2 class="year">{year}</h2>
      <ul class="post-list">
        {posts
          .filter((p) => p.data.date.getUTCFullYear() === year)
          .map((p) => (
            <li>
              <a class="post-row" href={`/${p.id}/`}>
                {p.data.hero && <img class="thumb" src={p.data.hero} alt="" loading="lazy" />}
                <div class="post-text">
                  <span class="post-title">{p.data.title}{p.data.draft && <span class="draft-chip">Draft</span>}</span>
                  <span class="post-excerpt">{p.data.description}</span>
                </div>
                <span class="post-date meta">{shortDate(p.data.date)}</span>
              </a>
            </li>
          ))}
      </ul>
    </section>
  ))}
</Base>

<style>
.intro{margin-bottom:3rem}
.intro h1{margin:0 0 .6rem;font-size:1.9rem}
.intro h1 .name{color:var(--accent);font-style:italic}
.intro p{color:var(--ink-soft);max-width:34rem;margin:0;font-size:.95rem}
.year-group{margin-bottom:2.5rem}
.year{font-family:var(--sans);letter-spacing:.08em;color:var(--ink-soft);border-bottom:1px solid var(--line);margin:0 0 .25rem;padding-bottom:.5rem;font-size:.8rem;font-weight:700}
.post-list{margin:0;padding:0;list-style:none}
.post-list li{border-bottom:1px solid var(--line)}
.post-list li:last-child{border-bottom:none}
.post-row{color:inherit;justify-content:space-between;align-items:baseline;gap:1.25rem;padding:1rem 0;display:flex}
.post-row:hover{text-decoration:none}
.post-row:hover .post-title{color:var(--accent)}
.thumb{object-fit:cover;border-radius:8px;flex-shrink:0;align-self:center;width:96px;height:60px}
.post-text{flex-direction:column;flex:1;gap:.2rem;min-width:0;display:flex}
.post-title{font-family:var(--display);font-size:1.05rem;font-weight:600;line-height:1.3;transition:color .15s}
.post-excerpt{color:var(--ink-soft);-webkit-line-clamp:1;-webkit-box-orient:vertical;font-size:.85rem;display:-webkit-box;overflow:hidden}
.post-date{flex-shrink:0}
.draft-chip{font-family:var(--sans);letter-spacing:.04em;text-transform:uppercase;color:#7a4a1f;vertical-align:middle;background:#f6d7a8;border-radius:999px;margin-left:.4rem;padding:.1rem .55rem;font-size:.7rem;font-weight:700}
@media (width<=540px){.post-row{flex-wrap:wrap;gap:.6rem}
.thumb{width:72px;height:48px}
.post-text{flex-basis:60%}
.post-date{flex-basis:100%;margin-left:calc(72px + .6rem)}
.intro h1{font-size:1.6rem}
}
</style>
