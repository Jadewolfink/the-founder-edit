---
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { CATEGORIES } from '../../content.config';
import { getPosts, navOrder, longDate } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = navOrder(await getPosts());
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, newer, older } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
const { title, description, date, category, hero, draft } = post.data;
const site = Astro.site!.toString().replace(/\/$/, '');

const blogPosting = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString().slice(0, 10),
  author: { '@type': 'Person', name: 'Yuhwen Foong', url: `${site}/about/` },
  publisher: { '@type': 'Person', name: 'Yuhwen Foong' },
  mainEntityOfPage: `${site}/${post.id}/`,
  ...(hero ? { image: `${site}${hero}` } : {}),
};
---

<Base title={`${title} | The Founder Edit`} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(blogPosting)} />
  <article>
    <header class="post-header">
      <a class="category-chip" href={`/category/${category}/`}>{CATEGORIES[category]}</a>
      {draft && <span class="category-chip draft-chip">Draft</span>}
      <h1>{title}</h1>
      <p class="meta">{longDate(date)} · {remarkPluginFrontmatter.minutesRead} min read</p>
    </header>
    {hero && <img class="hero" src={hero} alt="" loading="eager" />}
    <div class="prose">
      <Content />
    </div>
  </article>
  <nav class="post-nav">
    {older ? (
      <a class="nav-card" href={`/${older.id}/`}>
        <span class="meta">← Older</span>
        <span>{older.data.title}</span>
      </a>
    ) : <span />}
    {newer ? (
      <a class="nav-card next" href={`/${newer.id}/`}>
        <span class="meta">Newer →</span>
        <span>{newer.data.title}</span>
      </a>
    ) : <span />}
  </nav>
</Base>

<style>
.post-header{margin-bottom:1.75rem}
.draft-chip{color:#7a4a1f;background:#f6d7a8;margin-left:.5rem}
.post-header h1{margin:.75rem 0 .5rem;font-size:1.8rem}
.post-header .meta{margin:0}
.hero{width:100%;margin-bottom:1.75rem}
.prose{font-family:var(--display);font-size:1rem;line-height:1.7}
.prose :global(p){margin:0 0 1.25em}
.prose :global(h2){margin:2em 0 .6em;font-size:1.25rem}
.prose :global(h3){margin:1.6em 0 .5em;font-size:1.05rem}
.prose :global(blockquote){border-left:3px solid var(--accent);color:var(--ink-soft);margin:1.5em 0;padding:.25em 0 .25em 1.25em;font-style:italic}
.prose :global(hr){border:none;border-top:1px solid var(--line);width:40%;margin:2.5em auto}
.prose :global(img){margin:1.5em 0}
.post-nav{grid-template-columns:1fr 1fr;gap:1rem;margin-top:3.5rem;display:grid}
.nav-card{border:1px solid var(--line);background:var(--bg-raised);color:var(--ink);border-radius:14px;flex-direction:column;gap:.25rem;padding:1rem 1.15rem;font-size:.85rem;font-weight:600;line-height:1.4;display:flex}
.nav-card:hover{border-color:var(--accent);text-decoration:none}
.nav-card.next{text-align:right;align-items:flex-end}
@media (width<=540px){.post-nav{grid-template-columns:1fr}
.post-header h1{font-size:1.5rem}
}
</style>
